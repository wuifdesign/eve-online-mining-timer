{
  "name": "eve-online-mining-timer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sbx": "sbx run --name claude-eve-online-mining-timer",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "concurrently --group --kill-others-on-fail --names typecheck,oxlint,prettier \"npm:lint:typecheck\" \"npm:lint:oxlint\" \"npm:lint:prettier\"",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:oxlint:fix": "oxlint --deny-warnings --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:typecheck": "tsc --noEmit",
    "test": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "preact": "^11.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "24.22.0"
  }
}
